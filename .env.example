# --- Obligatoire en local ---
# DATABASE_URL : chaine de connexion Neon (postgresql://...?sslmode=require)
DATABASE_URL=
# JWT_SECRET : longue chaine aleatoire
JWT_SECRET=
# VITE_APP_ID : n'importe quelle valeur non vide, a choisir (signature de session)
VITE_APP_ID=


# --- OTP par e-mail (SMTP, ex. Gmail avec mot de passe d application). Sans config en dev, le code s affiche dans la console ---
# EMAIL_SERVER_HOST : ex. smtp.gmail.com, EMAIL_SERVER_PORT : ex. 465
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=

# --- Cloudinary (téléversement des images) : Dashboard > Settings > API Keys ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Public (aperçus de partage, sitemap) : adresse du site en production ---
SITE_URL=
